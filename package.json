    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.11.1",
    "binaryen": "^130.0.0",
    "cline": "^3.0.30",
    "clsx": "^2.1.1",
