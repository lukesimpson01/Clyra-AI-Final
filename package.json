  "description": "Clyra AI desktop assistant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Redlook096/Clyra-AI-Final.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Redlook096/Clyra-AI-Final/issues"
  },
  "homepage": "https://github.com/Redlook096/Clyra-AI-Final#readme",
  "build": {
    "appId": "ai.clyra.desktop",
    "productName": "Clyra",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/uiohook-napi/**/*",
      "node_modules/node-gyp-build/**/*"
    ],
    "asarUnpack": [
      "electron/native-pointer-darwin",
      "node_modules/uiohook-napi/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop-binaries",
        "to": ".",
        "filter": [
          "clyra-server*"
        ]
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "backend/voice-pipeline",
        "to": "backend/voice-pipeline"
      },
      {
        "from": "vendor/openfilm",
        "to": "vendor/openfilm",
        "filter": [
          "**/*",
          "!studio/ui/src/**",
          "!node_modules/.bin/**",
          "!node_modules/vite/**",
          "!node_modules/@vitejs/**",
          "!node_modules/@tailwindcss/**",
          "!node_modules/tailwindcss/**",
          "!node_modules/typescript/**",
          "!node_modules/@types/**",
          "!node_modules/@fontsource-variable/**",
          "!node_modules/lucide-react/**",
          "!node_modules/react/**",
          "!node_modules/react-dom/**"
        ]
      },
      {
        "from": "vendor/whisper.cpp/build",
        "to": "speech-runtime/build"
      },
      {
        "from": "vendor/whisper.cpp/models",
        "to": "speech-runtime/models",
        "filter": [
          "ggml-*-q5_1.bin",
          "ggml-parakeet-tdt-0.6b-v3-q4_k.bin"
        ]
      },
      {
        "from": "tools",
        "to": "tools"
      },
      {
        "from": "requirements-openhands.txt",
        "to": "requirements-openhands.txt"
      },
      {
        "from": "clipper-pipeline.py",
        "to": "clipper-pipeline.py"
      },
      {
        "from": "clipper_face_tracking.py",
        "to": "clipper_face_tracking.py"
      },
      {
        "from": "models/ultraface-rfb-320.onnx",
        "to": "models/ultraface-rfb-320.onnx"
      },
      {
        "from": "models/ULTRAFACE-LICENSE.txt",
        "to": "models/ULTRAFACE-LICENSE.txt"
      },
      {
        "from": "clipper_intelligence.py",
        "to": "clipper_intelligence.py"
      },
      {
        "from": "clipper_voiceover.py",
        "to": "clipper_voiceover.py"
      },
      {
        "from": "package-lock.json",
        "to": "package-lock.json"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Clyra needs microphone access for Clyra Flow (Cmd+L) and Voice Call.",
        "NSLocationWhenInUseUsageDescription": "Clyra Maps uses your location to show where you are and give accurate directions.",
        "NSLocationUsageDescription": "Clyra Maps uses your location to show where you are and give accurate directions.",
        "NSCameraUsageDescription": "Clyra needs camera access for Voice Call camera vision.",
        "NSScreenCaptureUsageDescription": "Clyra needs screen recording access to share your screen in Voice Call.",
        "NSAppleEventsUsageDescription": "Clyra needs Accessibility / Apple Events access to paste dictation into other apps."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-sdk-client": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-sdk-protocol": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.3",
    "@dimforge/rapier2d-compat": "^0.18.2",
    "@dimforge/rapier3d-compat": "^0.18.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@mapbox/vector-tile": "^1.3.1",
    "@opencode-ai/sdk": "^1.18.12",
    "@pipecat-ai/client-js": "^1.13.0",
    "@pipecat-ai/client-react": "^1.8.1",
    "@pipecat-ai/small-webrtc-transport": "^1.10.6",
    "@turf/turf": "^7.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "archiver": "^7.0.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "isomorphic-git": "^1.41.4",
    "katex": "^0.19.0",
    "liquid-glass-react": "^1.1.1",
    "maplibre-gl": "^4.7.1",
    "mediabunny": "^1.62.1",
    "node-pty": "^1.1.0",
    "pbf": "^3.3.0",
    "pixi.js": "^8.19.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1",
    "uiohook-napi": "^1.5.5"
  }
}
