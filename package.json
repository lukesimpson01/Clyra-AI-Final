    "opencluely:start": "node tools/start-opencluely.mjs",
    "test:opencluely": "node tools/opencluely-electron-tour.mjs",
    "test:browser-companion-visual": "node tools/browser-companion-visual-smoke.mjs",
    "test:study-brain": "tsx tools/study-brain-unit-tests.ts",
    "test:notes": "node tools/sqlite-abi.mjs node && tsx tools/notes-workspace-unit-tests.ts",
    "test:clyra-code-platform": "tsx tools/clyra-code-platform-unit-tests.ts",
    "test:clyra-code-library": "tsx tools/clyra-code-library-unit-tests.ts",
    "notes:vendor": "node -e \"const f=require('fs');f.mkdirSync('public/notes/vendor',{recursive:true});f.copyFileSync('node_modules/@xterm/xterm/lib/xterm.js','public/notes/vendor/xterm.js');f.copyFileSync('node_modules/@xterm/addon-fit/lib/addon-fit.js','public/notes/vendor/addon-fit.js');f.copyFileSync('node_modules/@xterm/xterm/css/xterm.css','public/notes/vendor/xterm.css');console.log('notes vendor refreshed')\"",
    "test:composer-dictation": "tsx tools/composer-dictation-unit-tests.ts",
    "test:clyra-code-brief": "tsx tools/clyra-code-brief-unit-tests.ts",
    "test:chat-intent": "tsx tools/chat-intent-unit-tests.ts",
    "test:chat-rich": "tsx tools/chat-rich-results-unit-tests.ts",
    "test:memory": "node tools/sqlite-abi.mjs node && tsx tools/memory-unit-tests.ts",
    "test:mail": "node tools/mail-mime-tests.mjs",
    "test:mail-e2e": "node tools/clyra-mail-live-smoke.mjs",
    "test:component-mcp": "tsx tools/component-mcp-unit-tests.ts",
    "setup:component-sources": "git submodule update --init --depth 1 external/shadcn-ui external/21st-mcp"
  },
  "devDependencies": {
    "@cline/sdk": "^0.0.52",
