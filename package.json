    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.5",
    "mathjs": "^15.2.0",
    "motion": "^12.23.24",
    "playwright": "^1.59.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
