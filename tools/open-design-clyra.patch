diff --git a/apps/daemon/src/clyra-bootstrap.ts b/apps/daemon/src/clyra-bootstrap.ts
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/apps/daemon/src/clyra-bootstrap.ts
+// Clyra Design-tab bootstrap.
+//
+// OpenDesign is embedded inside Clyra as its Design tab. Clyra launches this
+// daemon with the DeepSeek credentials already resolved from its own
+// environment, and the daemon injects them (plus the flags that skip the
+// first-run sign-in / provider-setup screens) into the served SPA shell.
+// The web app merges `window.__CLYRA_DESIGN_BOOTSTRAP__` in its loadConfig().
+//
+// This deliberately only ever touches the SPA shell document; every other
+// static asset is served untouched by express.static below it.
+
+import type { Express, NextFunction, Request, Response } from 'express';
+import fs from 'node:fs';
+import path from 'node:path';
+
+const API_KEY_ENV_NAMES = ['OD_DEEPSEEK_API_KEY', 'DEEPSEEK_API_KEY'];
+const BASE_URL_ENV_NAMES = ['OD_DEEPSEEK_BASE_URL', 'DEEPSEEK_BASE_URL'];
+const MODEL_ENV_NAMES = ['OD_DEEPSEEK_MODEL', 'DEEPSEEK_MODEL'];
+
+function envValue(names: string[]): string {
+  for (const name of names) {
+    const value = process.env[name];
+    if (typeof value === 'string' && value.trim()) return value.trim();
+  }
+  return '';
+}
+
+export function clyraBootstrapScript(): string {
+  const apiKey = envValue(API_KEY_ENV_NAMES);
+  if (!apiKey) return '';
+  const baseUrl = envValue(BASE_URL_ENV_NAMES) || 'https://api.deepseek.com';
+  const model = envValue(MODEL_ENV_NAMES) || 'deepseek-v4-pro';
+  const apiProtocol = baseUrl.includes('/anthropic') ? 'anthropic' : 'openai';
+  const apiConfig = {
+    baseUrl,
+    apiKey,
+    model,
+    apiVersion: '',
+    apiProviderBaseUrl: baseUrl,
+  };
+  const bootstrap = {
+    mode: 'daemon',
+    apiKey,
+    baseUrl,
+    model,
+    apiProtocol,
+    apiVersion: '',
+    apiProtocolConfigs: { [apiProtocol]: apiConfig },
+    apiProviderBaseUrl: baseUrl,
+    // The OpenCode CLI is the agent this machine runs (Clyra itself drives
+    // OpenCode for the Vibe Coder), and byok-opencode routes its runs
+    // through the DeepSeek credentials above. Codex is the product default
+    // but its install on this machine is broken, so pin the working one.
+    agentId: 'byok-opencode',
+    onboardingCompleted: true,
+    privacyDecisionAt: Date.now(),
+    configMigrationVersion: 3,
+    // Match the host product: Clyra Code's accent blue drives buttons,
+    // links, focus rings and the composer inside the embed.
+    accentColor: '#3977F6',
+  };
+  // The theme init script paints the accent before React hydrates, and it
+  // reads localStorage — seed that synchronously so the first paint already
+  // carries Clyra's blue instead of the product default. The rail-open seed
+  // keeps the sidebar docked open inside the embed (the product defaults it
+  // to collapsed, which reads as a broken sidebar in an iframe).
+  const accentSeed = `try{var c=JSON.parse(localStorage.getItem('open-design:config')||'{}');c.accentColor='#3977F6';localStorage.setItem('open-design:config',JSON.stringify(c));}catch(e){}try{localStorage.setItem('od.entry.railOpen','true');}catch(e){}`;
+  // Branding sweep: the embedded product carries Clyra's name everywhere.
+  // A MutationObserver rewrites any rendered text so no OpenDesign /
+  // OpenCode / Nexu string survives in menus, settings, or dialogs.
+  const brandSweep = `(function(){var R=[['OpenDesign','Clyra Design'],['OpenCode','Clyra'],['by Nexu Labs',''],['Research Preview','']];function s(n){if(n.nodeType===3){var t=n.nodeValue,v=null;for(var i=0;i<R.length;i++){if(t.indexOf(R[i][0])!==-1){t=t.split(R[i][0]).join(R[i][1]);v=true;}}if(v)n.nodeValue=t;}else if(n.nodeType===1&&n.childNodes){for(var i=0;i<n.childNodes.length;i++)s(n.childNodes[i]);}}function run(){if(document.body)s(document.body);}document.addEventListener('DOMContentLoaded',function(){run();new MutationObserver(function(){run();}).observe(document.body,{childList:true,subtree:true,characterData:true});});})();`;
+  // The Clyra Design theme lives in the web build (public/clyra-design.css)
+  // and is served by express.static; the shell just links it. It carries the
+  // light-theme sweep, the docked sidebar, the bubble polish, the welcome
+  // restyle and the Apple-style preview skeleton.
+  const themeLink = `<link rel="stylesheet" href="/clyra-design.css" />`;
+  return `<script>${accentSeed}</script><script>window.__CLYRA_DESIGN_BOOTSTRAP__=${JSON.stringify(bootstrap)};document.documentElement.setAttribute('data-clyra-embed','1');</script><script>${brandSweep}</script>${themeLink}`;
+}
+
+/**
+ * Registers a middleware that serves the SPA shell with the bootstrap script
+ * injected. Placed before express.static so `/` and deep links pick up the
+ * injected document while real files still flow to the static handler.
+ */
+export function installClyraBootstrap(app: Express, staticDir: string): void {
+  const script = clyraBootstrapScript();
+  if (!script) return;
+  const indexPath = path.join(staticDir, 'index.html');
+  if (!fs.existsSync(indexPath)) return;
+
+  // The daemon-side copy of the user preferences must agree with the web
+  // bootstrap: default the agent to the BYOK OpenCode runtime (Codex is the
+  // product default but is not installed on this machine), and keep the
+  // onboarding ratchet resolved. Only seeds; an existing explicit choice wins.
+  try {
+    const projectRoot = path.resolve(staticDir, '..', '..', '..');
+    const dataDir = process.env.OD_DATA_DIR?.trim()
+      ? path.isAbsolute(process.env.OD_DATA_DIR)
+        ? process.env.OD_DATA_DIR
+        : path.resolve(projectRoot, process.env.OD_DATA_DIR)
+      : path.join(projectRoot, '.od');
+    const configFile = path.join(dataDir, 'app-config.json');
+    let config: Record<string, unknown> = {};
+    try {
+      config = JSON.parse(fs.readFileSync(configFile, 'utf8')) as Record<string, unknown>;
+    } catch {
+      fs.mkdirSync(dataDir, { recursive: true });
+    }
+    let changed = false;
+    if (config.agentId === undefined || config.agentId === 'codex') {
+      config.agentId = 'byok-opencode';
+      changed = true;
+    }
+    if (config.onboardingCompleted !== true) {
+      config.onboardingCompleted = true;
+      changed = true;
+    }
+    if (changed) {
+      fs.writeFileSync(configFile, JSON.stringify(config, null, 2));
+    }
+  } catch {
+    /* the daemon's own config reader stays authoritative on failure */
+  }
+
+  const shellHtml = (() => {
+    try {
+      let html = fs.readFileSync(indexPath, 'utf8');
+      if (!html.includes('__CLYRA_DESIGN_BOOTSTRAP__')) {
+        const headMatch = /<head([^>]*)>/i.exec(html);
+        if (headMatch) {
+          html = `${html.slice(0, headMatch.index + headMatch[0].length)}${script}${html.slice(headMatch.index + headMatch[0].length)}`;
+        }
+      }
+      return html;
+    } catch {
+      return null;
+    }
+  })();
+
+  app.use((req: Request, res: Response, next: NextFunction) => {
+    if (req.method !== 'GET' && req.method !== 'HEAD') return next();
+    const pathname = req.path;
+    if (pathname.startsWith('/api/') || pathname === '/api') return next();
+    if (pathname.startsWith('/_next/') || pathname === '/_next') return next();
+    if (pathname.startsWith('/artifacts/') || pathname === '/artifacts') return next();
+    if (pathname.startsWith('/frames/') || pathname === '/frames') return next();
+
+    // Real files (including /favicon.ico and every hashed asset) go to
+    // express.static untouched. Only the shell document is rewritten.
+    const isShellRequest =
+      pathname === '/' || pathname === '/index.html' || pathname.endsWith('/');
+    const wantsDocument = isShellRequest
+      || ((req.headers.accept ?? '').includes('text/html')
+        && !fs.existsSync(path.join(staticDir, decodeURIComponent(pathname).replace(/^\/+/, ''))));
+    if (!wantsDocument || shellHtml == null) return next();
+
+    res.setHeader('Content-Type', 'text/html; charset=utf-8');
+    res.setHeader('Cache-Control', 'no-cache');
+    if (req.method === 'HEAD') return res.end();
+    res.send(shellHtml);
+  });
+}

