+++ b/apps/web/src/components/ClyraDeployButton.tsx
+import { useEffect, useRef, useState } from 'react';
+import { isClyraEmbed } from '../clyra-embed';
+import { Icon } from './Icon';
+
+type DeployResult = { type: string; projectId?: string; ok?: boolean; url?: string; error?: string };
+
+/**
+ * Deploys the current OpenDesign project to GitHub Pages for free. The heavy
+ * lifting (git push + Pages enable via the host's authenticated `gh` CLI)
+ * runs on the Clyra side; this button only posts `clyra:deploy` and renders
+ * the result that the host posts back.
+ */
+export function ClyraDeployButton({ projectId }: { projectId: string }) {
+  const [state, setState] = useState<'idle' | 'deploying' | 'live' | 'error'>('idle');
+  const [url, setUrl] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const busyRef = useRef(false);
+
+  useEffect(() => {
+    const onMessage = (event: MessageEvent) => {
+      const payload = event.data as DeployResult | null;
+      if (!payload || payload.type !== 'clyra:deploy-result' || payload.projectId !== projectId) return;
+      busyRef.current = false;
+      if (payload.ok && payload.url) {
+        setUrl(payload.url);
+        setState('live');
+      } else {
+        setError(payload.error ?? 'Deploy failed.');
+        setState('error');
+      }
+    };
+    window.addEventListener('message', onMessage);
+    return () => window.removeEventListener('message', onMessage);
+  }, [projectId]);
+
+  if (!isClyraEmbed() || !projectId) return null;
+
+  const deploy = () => {
+    if (busyRef.current) return;
+    busyRef.current = true;
+    setError(null);
+    setState('deploying');
+    try {
+      window.parent.postMessage({ type: 'clyra:deploy', projectId }, '*');
+    } catch {
+      busyRef.current = false;
+      setState('error');
+      setError('Could not reach Clyra to deploy.');
+    }
+  };
+
+  const openLive = () => {
+    if (url) window.open(url, '_blank', 'noopener,noreferrer');
+  };
+
+  if (state === 'live' && url) {
+    return (
+      <button
+        type="button"
+        onClick={openLive}
+        title={`Live at ${url}`}
+        style={{
+          position: 'fixed',
+          bottom: 64,
+          right: 18,
+          zIndex: 60,
+          display: 'inline-flex',
+          alignItems: 'center',
+          gap: 7,
+          height: 34,
+          padding: '0 13px',
+          borderRadius: 10,
+          border: '1px solid rgba(38, 138, 80, 0.35)',
+          background: '#ffffff',
+          color: '#268A50',
+          fontSize: 12.5,
+          fontWeight: 600,
+          letterSpacing: '-0.01em',
+          cursor: 'pointer',
+          boxShadow: '0 4px 14px rgba(31, 32, 36, 0.08)',
+          fontFamily: 'inherit',
+        }}
+      >
+        <Icon name="external-link" size={13} />
+        View live site
+      </button>
+    );
+  }
+
+  const deployGlyph = state === 'deploying'
+    ? (
+      <span
+        style={{
+          width: 13,
+          height: 13,
+          borderRadius: 999,
+          border: '1.5px solid #C1C3C7',
+          borderTopColor: '#3977F6',
+          animation: 'clyra-spin 0.8s linear infinite',
+          display: 'inline-block',
+        }}
+      />
+    )
+    : <Icon name={state === 'error' ? 'alert-triangle' : 'upload'} size={13} />;
+  const deployLabel = state === 'deploying'
+    ? 'Deploying…'
+    : state === 'error' ? 'Retry deploy' : 'Deploy to live site';
+
+  return (
+    <button
+      type="button"
+      onClick={deploy}
+      title={state === 'error' ? `${error} — retry` : 'Deploy this design to a live website on GitHub Pages (free)'}
+      style={{
+        position: 'fixed',
+        bottom: 64,
+        right: 18,
+        zIndex: 60,
+        display: 'inline-flex',
+        alignItems: 'center',
+        gap: 7,
+        height: 34,
+        padding: '0 13px',
+        borderRadius: 10,
+        border: '1px solid rgba(31, 32, 36, 0.1)',
+        background: '#ffffff',
+        color: state === 'error' ? '#C24949' : '#45474C',
+        fontSize: 12.5,
+        fontWeight: 600,
+        letterSpacing: '-0.01em',
+        cursor: 'pointer',
+        boxShadow: '0 4px 14px rgba(31, 32, 36, 0.08)',
+        fontFamily: 'inherit',
+        opacity: state === 'deploying' ? 0.7 : 1,
+      }}
+    >
+      {deployGlyph}
+      {deployLabel}
+    </button>
+  );
+}

