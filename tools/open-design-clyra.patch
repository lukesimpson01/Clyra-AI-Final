+  projectName?: string | null;
+  variant?: 'floating' | 'inline';
+}) {
+  if (!isClyraEmbed() || !projectId) return null;
+
+  const send = () => {
+    try {
+      window.parent.postMessage(
+        { type: 'clyra:send-to-code', projectId, projectName: projectName ?? undefined },
