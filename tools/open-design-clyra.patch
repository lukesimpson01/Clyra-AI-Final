+++ b/apps/web/public/clyra-design.css
+/* Clyra Design — embed theme layer for the OpenDesign frontend.
+   Injected by the daemon (apps/daemon/src/clyra-bootstrap.ts) into the
+   served shell. Everything is scoped to html[data-clyra-embed] so the stock
+   product stays untouched outside the embed. */
+
+/* ------------------------------------------------------------------ */
+/* Base: light, quiet, Clyra-blue                                     */
+/* ------------------------------------------------------------------ */
+html[data-clyra-embed] {
+  /* Kill the product's saturated green accents; Clyra Code's blue is the
+     only accent in the embed. */
+  --green: #3977F6;
+  --green-bg: rgba(57, 119, 246, 0.08);
+  --green-border: rgba(57, 119, 246, 0.25);
+  --beam-color: #3977F6;
+  --beam-color-2: #7CA6F8;
+  /* The composer send mark: blue disc, white glyph (was black/green). */
+  --send-ink: #3977F6;
+  --send-ground: #ffffff;
+  /* Any remaining semantic greens fold into the blue accent. */
+  --success: #3977F6;
+  --success-bg: rgba(57, 119, 246, 0.08);
+  --success-border: rgba(57, 119, 246, 0.25);
+}
+
+/* Promo / cloud surfaces have no place in the embed. */
+html[data-clyra-embed] .entry-deepseek-campaign-badge,
+html[data-clyra-embed] [class*="campaign-badge"],
+html[data-clyra-embed] [class*="credits-pill"],
+html[data-clyra-embed] [class*="free-credits"],
+html[data-clyra-embed] [data-testid="entry-nav-community"],
+html[data-clyra-embed] [data-testid="entry-settings-button"],
+html[data-clyra-embed] [class*="upgrade-pill"],
+html[data-clyra-embed] [class*="upgradePill"] {
+  display: none !important;
+}
+
+/* ------------------------------------------------------------------ */
+/* Sidebar: docked open, labels visible, toggles hidden                */
+/* ------------------------------------------------------------------ */
+html[data-clyra-embed] .entry-shell--no-header .entry.entry--rail-open {
+  grid-template-columns: 236px minmax(0, 1fr) !important;
+}
+html[data-clyra-embed] .entry--rail-open .entry-nav-rail {
+  overflow: visible !important;
+  pointer-events: auto !important;
+}
+/* The top-bar rail toggle and the rail's collapse button are removed in the
+   embed: the sidebar simply stays open. */
+html[data-clyra-embed] .workspace-tab__rail-toggle,
+html[data-clyra-embed] .entry-nav-rail__collapse {
+  display: none !important;
+}
+
+/* ------------------------------------------------------------------ */
+/* Chat bubbles — exactly the Clyra Code surface                      */
+/* ------------------------------------------------------------------ */
+html[data-clyra-embed] .msg.user .user-text {
+  color: #172033 !important;
+  background: #F3F3F2 !important;
+  border: none !important;
+  border-radius: 11px !important;
+  padding: 9px 13px !important;
+  font-weight: 500 !important;
+  box-shadow: none !important;
+}
+html[data-clyra-embed] .msg.user .user-text-more,
+html[data-clyra-embed] .msg.user .user-text.is-cut .user-text-more {
+  color: #172033 !important;
+  background: linear-gradient(to right, transparent 0, #F3F3F2 26px) !important;
+}
+
+/* ------------------------------------------------------------------ */
+/* Action / timeline rows: normal font, colour, shimmer               */
+/* (The row colours themselves live in record.module.css — CSS-module
+   class names are hashed, so the module file owns them.)             */
+/* ------------------------------------------------------------------ */
+html[data-clyra-embed] {
+  --chat-font-mono: -apple-system, BlinkMacSystemFont, "SF Pro Text",
+    "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+}
+
+/* ------------------------------------------------------------------ */
+/* Welcome: quiet, centered, Clyra-Code-like                           */
+/* ------------------------------------------------------------------ */
+/* ------------------------------------------------------------------ */
+/* Welcome: the product's own hero, untouched by the embed theme.      */
+/* ------------------------------------------------------------------ */
+html[data-clyra-embed] .home-hero__composer-beam {
+  display: none !important;
+}
+/* Recent projects: light rows like the Clyra sidebar. */
+html[data-clyra-embed] [class*="recent"] [class*="row"],
+html[data-clyra-embed] [class*="recent-item"] {
+  border-radius: 9px;
+}
+html[data-clyra-embed] [class*="recent-item"]:hover {
+  background: rgba(0, 0, 0, 0.04);
+}
+
+/* ------------------------------------------------------------------ */
+/* Preview loading: Apple-style skeleton + scanning bar               */
+/* ------------------------------------------------------------------ */
+html[data-clyra-embed] .viewer-loading {
+  position: relative;
+  overflow: hidden;
+  background: #FAFAF8;
+}
+html[data-clyra-embed] .viewer-loading-card,
+html[data-clyra-embed] .viewer-loading-card span {
+  background: #EFEFED !important;
+  border-radius: 8px;
+  animation: clyra-skeleton-breathe 1.5s ease-in-out infinite;
+}
+html[data-clyra-embed] .viewer-loading-card-back {
+  animation-delay: 0.15s;
+}
+html[data-clyra-embed] .viewer-loading-card-main {
+  animation-delay: 0.3s;
+}
+@keyframes clyra-skeleton-breathe {
+  0%, 100% { opacity: 0.55; transform: scale(0.995); }
+  50% { opacity: 1; transform: scale(1); }
+}
+/* A soft scanning bar travels the whole preview while the agent designs. */
+html[data-clyra-embed] .viewer-loading::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  height: 2px;
+  top: -2px;
+  background: linear-gradient(90deg, transparent, rgba(57, 119, 246, 0.75), transparent);
+  animation: clyra-scan-bar 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
+  z-index: 2;
+}
+@keyframes clyra-scan-bar {
+  0% { top: -2px; }
+  100% { top: calc(100% + 2px); }
+}
+
+/* Generic shimmer for any loading/working surface the embed shows. */
+html[data-clyra-embed] [class*="skeleton"],
+html[data-clyra-embed] [class*="Skeleton"] {
+  position: relative;
+  overflow: hidden;
+}
+html[data-clyra-embed] [class*="skeleton"]::after,
+html[data-clyra-embed] [class*="Skeleton"]::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(
+    100deg,
+    transparent 30%,
+    rgba(255, 255, 255, 0.6) 50%,
+    transparent 70%
+  );
+  background-size: 200% 100%;
+  animation: clyra-skeleton-shimmer 1.4s ease-in-out infinite;
+  pointer-events: none;
+}
+@keyframes clyra-skeleton-shimmer {
+  0% { background-position: 180% 0; }
+  100% { background-position: -80% 0; }
+}
+@keyframes clyra-spin {
+  to { transform: rotate(360deg); }
+}
+
+/* ------------------------------------------------------------------ */
+/* Browser surfaces: light, quiet chrome like the rest of the embed    */
+/* ------------------------------------------------------------------ */
+html[data-clyra-embed] [class*="browser"],
+html[data-clyra-embed] [class*="Browser"] {
+  background: #FFFFFF;
+  border-color: rgba(0, 0, 0, 0.06);
+  border-radius: 10px;
+}
+html[data-clyra-embed] [class*="browser"] [class*="tab"],
+html[data-clyra-embed] [class*="browser-tab"] {
+  background: #F7F7F5;
+  border: 1px solid rgba(0, 0, 0, 0.05);
+  border-radius: 8px;
+  font-family: inherit;
+}
+html[data-clyra-embed] [class*="browser"] [class*="address"],
+html[data-clyra-embed] [class*="browser"] input {
+  background: #F2F2F0;
+  border: 1px solid rgba(0, 0, 0, 0.05);
+  border-radius: 8px;
+  font-family: inherit;
+}
+html[data-clyra-embed] [class*="browser"] [class*="active"] {
+  background: #FFFFFF;
+  color: #1F2024;
+}
+
+/* ------------------------------------------------------------------ */
+/* Motions are spatial, not decorative                                */
+/* ------------------------------------------------------------------ */
+@media (prefers-reduced-motion: reduce) {
+  html[data-clyra-embed] .tool.pending::after,
+  html[data-clyra-embed] .viewer-loading::before,
+  html[data-clyra-embed] .viewer-loading-card,
+  html[data-clyra-embed] [class*="skeleton"]::after {
+    animation: none !important;
+  }
+}

