+++ b/apps/web/src/clyra-embed.ts
+/**
+ * When OpenDesign runs embedded inside Clyra's Design tab, the daemon injects
+ * `window.__CLYRA_DESIGN_BOOTSTRAP__` into the SPA shell (see
+ * apps/daemon/src/clyra-bootstrap.ts). The embed preconfigures the provider
+ * and resolves onboarding, and the cloud sign-in surfaces are hidden: the
+ * embedded product is a local design tool, not an OpenDesign Cloud client.
+ */
+export function isClyraEmbed(): boolean {
+  if (typeof window === 'undefined') return false;
+  return (
+    (window as unknown as { __CLYRA_DESIGN_BOOTSTRAP__?: unknown })
+      .__CLYRA_DESIGN_BOOTSTRAP__ != null
+  );
+}

