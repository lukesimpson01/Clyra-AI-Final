+++ b/apps/web/src/components/ClyraDesignRecents.tsx
+import { useEffect, useMemo, useState } from 'react';
+import { projectFileUrl } from '../providers/registry';
+import { isClyraEmbed } from '../clyra-embed';
+import { Icon } from './Icon';
+import type { Project, ProjectFile } from '../types';
+
+type Entry = { name: string };
+
+function entryOf(files: ProjectFile[] | undefined): Entry | null {
+  if (!files?.length) return null;
+  const html =
+    files.find((f) => f.path === 'index.html' || f.name === 'index.html') ??
+    files
+      .filter((f) => f.kind === 'html')
+      .sort((a, b) => Number(b.mtime) - Number(a.mtime))[0];
+  if (html) return { name: html.path ?? html.name };
+  const image = files.find((f) => f.kind === 'image');
+  return image ? { name: image.path ?? image.name } : null;
+}
+
+/**
+ * Recent projects for the embedded Design welcome: three cards, each with a
+ * live preview of the project's page, plus a Show more action. Replaces the
+ * template showcase under the composer.
+ */
+export function ClyraDesignRecents({
+  projects,
+  onOpen,
+  onViewAll,
+}: {
+  projects: Project[];
+  onOpen: (id: string) => void;
+  onViewAll?: () => void;
+}) {
+  const recent = useMemo(
+    () =>
+      [...projects]
+        .sort((a, b) => Number(b.updatedAt) - Number(a.updatedAt))
+        .slice(0, 3),
+    [projects],
+  );
+  const [entries, setEntries] = useState<Record<string, Entry | null>>({});
+
+  useEffect(() => {
+    let cancelled = false;
+    for (const project of recent) {
+      void fetch(`/api/projects/${encodeURIComponent(project.id)}/files`)
+        .then((response) => (response.ok ? response.json() : { files: [] }))
+        .then((body: { files?: ProjectFile[] }) => {
+          if (cancelled) return;
+          setEntries((prev) => ({ ...prev, [project.id]: entryOf(body.files ?? []) }));
+        })
+        .catch(() => {
+          if (!cancelled) setEntries((prev) => ({ ...prev, [project.id]: null }));
+        });
+    }
+    return () => { cancelled = true; };
+  }, [recent]);
+
+  if (!isClyraEmbed() || recent.length === 0) return null;
+
+  return (
+    <section className="clyra-recents" aria-label="Recent projects">
+      <header className="clyra-recents__head">
+        <h2>Recent projects</h2>
+        {onViewAll ? (
+          <button type="button" onClick={onViewAll}>
+            <span>Show more</span>
+            <Icon name="chevron-right" size={12} />
+          </button>
+        ) : null}
+      </header>
+      <div className="clyra-recents__grid">
+        {recent.map((project) => {
+          const entry = entries[project.id];
+          return (
+            <button
+              key={project.id}
+              type="button"
+              className="clyra-recents__card"
+              onClick={() => onOpen(project.id)}
+              title={project.name}
+            >
+              <span className="clyra-recents__preview" aria-hidden>
+                {entry ? (
+                  <iframe
+                    title={project.name}
+                    src={projectFileUrl(project.id, entry.name)}
+                    loading="lazy"
+                    tabIndex={-1}
+                    sandbox=""
+                    style={{ pointerEvents: 'none' }}
+                  />
+                ) : (
+                  <span className="clyra-recents__glyph">
+                    {(project.name.trim()[0] ?? '?').toUpperCase()}
+                  </span>
+                )}
+              </span>
+              <span className="clyra-recents__name">{project.name}</span>
+            </button>
+          );
+        })}
+      </div>
+      <style>{`
+        .clyra-recents { width: 100%; max-width: 860px; margin: 22px auto 28px; padding: 0 20px; box-sizing: border-box; }
+        .clyra-recents__head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; padding: 0 2px; }
+        .clyra-recents__head h2 { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: -0.01em; color: #1F2024; }
+        .clyra-recents__head button { display: inline-flex; align-items: center; gap: 2px; border: 0; background: none; padding: 0; font: inherit; font-size: 12px; font-weight: 500; color: #3977F6; cursor: pointer; }
+        .clyra-recents__head button:hover { text-decoration: underline; }
+        .clyra-recents__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
+        .clyra-recents__card { display: flex; flex-direction: column; gap: 8px; border: 1px solid rgba(0, 0, 0, 0.07); border-radius: 12px; background: #ffffff; padding: 0; overflow: hidden; text-align: left; cursor: pointer; box-shadow: 0 1px 2px rgba(31, 32, 36, 0.04); transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease, border-color 180ms ease; }
+        .clyra-recents__card:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(31, 32, 36, 0.1); border-color: rgba(57, 119, 246, 0.35); }
+        .clyra-recents__preview { display: block; aspect-ratio: 16 / 9.5; width: 100%; background: #F7F7F5; border-bottom: 1px solid rgba(0, 0, 0, 0.05); overflow: hidden; }
+        .clyra-recents__preview iframe { width: 100%; height: 100%; border: 0; transform: scale(0.62); transform-origin: top left; }
+        .clyra-recents__glyph { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; font-size: 26px; font-weight: 600; color: #3977F6; background: linear-gradient(135deg, rgba(57,119,246,0.08), rgba(57,119,246,0.02)); }
+        .clyra-recents__name { padding: 0 12px 11px; font-size: 12.5px; font-weight: 500; color: #45474C; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+        @media (max-width: 700px) { .clyra-recents__grid { grid-template-columns: 1fr; } }
+      `}</style>
+    </section>
+  );
+}
